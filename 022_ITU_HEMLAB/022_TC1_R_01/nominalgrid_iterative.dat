DATASETAUXDATA N_NUMBEROFUNKNOWNS_AOA_20p0  = "8531871"

DATASETAUXDATA TIMESTEPPING_METHOD_10p0 = "local-time-stepping -or- time-accurate"
DATASETAUXDATA TIMESTEPPING_METHOD_20p0 = "local-time-stepping -or- time-accurate"

ZONE T="022 TC1 <greek>a<\greek> = 10<math>0<\math>"
